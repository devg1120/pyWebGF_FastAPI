from natsort import natsorted

data = ["s1", "s2", "s3", "s4", "s5", "s6", "s10"]

# 自然順でソート
result = natsorted(data)

print(result)
# 出力: ['s1', 's2', 's3', 's4', 's5', 's6', 's10']



